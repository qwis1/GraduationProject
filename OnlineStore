SELECT s.ShipmentDate, sup.SupplierName, p.ProductName, si.Quantity, si.PurchasePrice
FROM ShipmentItems si
JOIN IncomingShipments s ON si.ShipmentID = s.ShipmentID
JOIN Suppliers sup ON s.SupplierID = sup.SupplierID
JOIN Products p ON si.ProductID = p.ProductID
ORDER BY s.ShipmentDate DESC;
