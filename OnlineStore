UPDATE Products SET StockQuantity = 
    CASE ProductID
        WHEN 1 THEN (SELECT COALESCE(SUM(Quantity),0) FROM ShipmentItems WHERE ProductID=1) - (SELECT COALESCE(SUM(Quantity),0) FROM InventoryMovements WHERE ProductID=1 AND MovementType IN ('sale','writeoff'))
        WHEN 2 THEN (SELECT COALESCE(SUM(Quantity),0) FROM ShipmentItems WHERE ProductID=2) - (SELECT COALESCE(SUM(Quantity),0) FROM InventoryMovements WHERE ProductID=2 AND MovementType IN ('sale','writeoff'))
        WHEN 3 THEN 300 - 80
        WHEN 4 THEN 100 - 15
        WHEN 5 THEN 80 - 5
        WHEN 6 THEN 60 - 30
    END
WHERE ProductID IN (1,2,3,4,5,6);

