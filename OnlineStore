CREATE TABLE Products (
    ProductID SERIAL PRIMARY KEY,
    ProductName VARCHAR(100) NOT NULL,
    Category VARCHAR(50) NOT NULL,
    Unit VARCHAR(20) NOT NULL,
    Price DECIMAL(10,2) NOT NULL CHECK (Price > 0),
    RetailPrice DECIMAL(10,2) NOT NULL CHECK (RetailPrice > 0),
    StockQuantity INTEGER NOT NULL DEFAULT 0 CHECK (StockQuantity >= 0)
);

CREATE TABLE Suppliers (
    SupplierID SERIAL PRIMARY KEY,
    SupplierName VARCHAR(100) NOT NULL UNIQUE,
    ContactPerson VARCHAR(100),
    Phone VARCHAR(20),
    Email VARCHAR(100)
);

CREATE TABLE IncomingShipments (
    ShipmentID SERIAL PRIMARY KEY,
    SupplierID INTEGER NOT NULL REFERENCES Suppliers(SupplierID),
    ShipmentDate DATE NOT NULL DEFAULT CURRENT_DATE,
    TotalCost DECIMAL(12,2) NOT NULL DEFAULT 0.00
);

CREATE TABLE ShipmentItems (
    ItemID SERIAL PRIMARY KEY,
    ShipmentID INTEGER NOT NULL REFERENCES IncomingShipments(ShipmentID) ON DELETE CASCADE,
    ProductID INTEGER NOT NULL REFERENCES Products(ProductID),
    Quantity INTEGER NOT NULL CHECK (Quantity > 0),
    PurchasePrice DECIMAL(10,2) NOT NULL
);

CREATE TABLE InventoryMovements (
    MovementID SERIAL PRIMARY KEY,
    ProductID INTEGER NOT NULL REFERENCES Products(ProductID),
    MovementType VARCHAR(10) NOT NULL CHECK (MovementType IN ('sale', 'writeoff')),
    Quantity INTEGER NOT NULL CHECK (Quantity > 0),
    MovementDate TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

